{
  "schema_version": 1,
  "model_id": "M5",
  "model_name": "RelationNetSpatial",
  "reference": "Sung et al., Learning to Compare: Relation Network for Few-Shot Learning, CVPR 2018",
  "backbone": "resnet18_imagenet1k_v1_spatial_layer4",
  "fine_tune_backbone": true,
  "spatial_feature_shape_at_224": [512, 7, 7],
  "support_aggregation": "elementwise_sum_by_class",
  "relation_module": {
    "pair_combination": "channel_concatenation",
    "first_hidden_channels": 256,
    "second_hidden_channels": 64,
    "fully_connected_hidden": 8,
    "relation_score_activation": "sigmoid"
  },
  "objective": {
    "name": "mean_squared_error",
    "targets": "one_hot_class_match",
    "reduction": "mean_over_classes_then_queries"
  },
  "prediction": {
    "class_rule": "maximum_relation_score",
    "probability_rule": "normalize_sigmoid_relation_scores_by_sum",
    "probability_epsilon": 1e-12,
    "retain_raw_relation_scores": true,
    "retain_pre_sigmoid_logits": true
  },
  "optimizer": {
    "name": "Adam",
    "learning_rate_candidates": [0.0001, 0.0003],
    "betas": [0.9, 0.999],
    "epsilon": 1e-8,
    "weight_decay": 0.0
  },
  "learning_rate_selection": {
    "split_id": "split_01",
    "common_across_shots": true,
    "primary_metric": "mean_validation_accuracy",
    "tie_breakers": ["mean_validation_macro_f1", "negative_mean_validation_loss"]
  },
  "learning_rate_schedule": "constant",
  "gradient_clipping": null,
  "resource_monitor_interval_episodes": 100,
  "mixed_precision_on_cuda": true,
  "training_seed": 20261004,
  "seed_stability": {
    "analysis_role": "supplementary",
    "split_id": "split_01",
    "training_seeds": [20261004, 20261005, 20261006]
  }
}
